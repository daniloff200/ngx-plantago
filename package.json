{
	"name": "ngx-plantago",
	"displayName": "ngx-plantago",
	"icon": "images/icon.png",
	"description": "Extension for migrating your AngularJS code to Angular 13",
	"version": "0.0.1",
	"repository": "https://github.com/daniloff200/ngx-plantago",
	"publisher": "daniloff200",
	"engines": {
		"vscode": "^1.31.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:extension.ngx-plantago"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.ngx-plantago",
				"title": "ngx-plantago"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run copy",
		"copy": "cp -r node_modules out/node_modules/",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --no-config 'src/test/**/*.test.ts'",
		"examples": "TS_NODE_PROJECT=tsconfig.test.json ts-node examples/run-examples.ts"
	},
	"devDependencies": {
		"@types/esprima": "4.0.2",
		"@types/mocha": "^2.2.48",
		"@types/node": "10.17.60",
		"@types/prettier": "1.19.1",
		"@types/vscode": "1.31.0",
		"mocha": "^11.7.5",
		"ts-node": "^10.9.2",
		"tslint": "5.20.1",
		"typescript": "3.3.4000"
	},
	"dependencies": {
		"@types/cheerio": "0.22.10",
		"@types/htmlparser2": "3.10.7",
		"@types/js-beautify": "1.8.1",
		"@types/lodash": "4.14.121",
		"@types/parse5": "5.0.0",
		"cheerio": "1.0.0-rc.3",
		"esprima": "4.0.1",
		"js-beautify": "1.9.1",
		"js-to-ts-converter": "0.16.2",
		"lodash": "4.17.21",
		"parse5": "5.1.0",
		"pascal-case": "2.0.1",
		"prettier": "1.16.4",
		"strip-comments": "1.0.2"
	}
}
